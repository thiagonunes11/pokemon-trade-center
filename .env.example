# Copie para .env e preencha com os valores do Firebase Console.
# Não commite o .env. Os arquivos nativos também ficam só na sua máquina:
#   google-services.json, GoogleService-Info.plist (veja os *.example na raiz).

# Comum (Configurações do projeto → Geral, ou app Web)
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Android — google-services.json → client[0].api_key e mobilesdk_app_id
EXPO_PUBLIC_FIREBASE_API_KEY_ANDROID=
EXPO_PUBLIC_FIREBASE_APP_ID_ANDROID=

# iOS — GoogleService-Info.plist → API_KEY e GOOGLE_APP_ID
EXPO_PUBLIC_FIREBASE_API_KEY_IOS=
EXPO_PUBLIC_FIREBASE_APP_ID_IOS=
